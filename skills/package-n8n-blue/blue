"""Thin launcher for package-n8n-blue.

This file is both the skill payload and the repository entry point —
blue/blue in the repository is a symlink to it. It deliberately holds no
logic of its own: validation, the graph and the steps all live in the
package-n8n-blue library, where the test suite reaches them. A copied
payload is the one place in this project where code cannot be tested, so
nothing that can live elsewhere should live here.
"""

import os
import subprocess
import sys

UNPINNED_ERROR = """\
this launcher carries no n8n pin.
It has not been stamped by `bb pin`, which cannot run until the n8n
repository has been pushed.
Point it at a checkout meanwhile: N8N_LIB_ROOT=/path/to/n8n
(or run through the repository project: cd n8n/blue && uv run python -m package_n8n_blue ...)
"""


def _lib_root_project(root: str) -> str:
    """The uv project inside an N8N_LIB_ROOT checkout: the repository
    root or its blue/ implementation both work."""
    if os.path.isfile(os.path.join(root, "pyproject.toml")):
        return root
    return os.path.join(root, "blue")


def main() -> None:
    root = os.environ.get("N8N_LIB_ROOT")
    if root:
        result = subprocess.run(
            ["uv", "run", "--project", _lib_root_project(root),
             "python", "-m", "package_n8n_blue", *sys.argv[1:]])
        raise SystemExit(result.returncode)
    try:
        from package_n8n_blue import exec  # resolvable only once pinned
    except ImportError:
        sys.stderr.write(UNPINNED_ERROR)
        raise SystemExit(2)
    exec()


if __name__ == "__main__":
    main()
